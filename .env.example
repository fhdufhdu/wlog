BIND_ADDR=127.0.0.1:3000
DATABASE_URL=postgres://wlog:wlog@127.0.0.1:5432/wlog?sslmode=disable
PUBLIC_BASE_URL=http://127.0.0.1:3000
SITE_NAME=Wlog
SITE_DESCRIPTION=개발하고 운영하며 알게 된 것을 기록합니다.
DEFAULT_SOCIAL_IMAGE=
ADMIN_USERNAME=owner
# `go run ./cmd/hash_password` 출력값을 넣으세요.
ADMIN_PASSWORD_HASH=$argon2id$v=19$REPLACE_ME
# `openssl rand -base64 48` 출력값을 넣으세요. 최소 32바이트입니다.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SECURE_COOKIE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
IMAGE_MAX_DIMENSION=2560
IMAGE_MAX_PIXELS=40000000
IMAGE_WEBP_QUALITY=82
IMAGE_ORPHAN_GRACE_HOURS=24
# 기존 Rust/SQLx DB를 처음 인계하는 배포에서 true로 설정하세요.
MIGRATION_BASELINE_EXISTING=false
